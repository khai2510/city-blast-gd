{
 "_readme": [
  "Format of ONE level as the City Blast level editor exports it (JSON.stringify(def), the runtime LEVELS[i]). Use it for new-level proposals: fill 'minimal_example' style fields; copy a hero from 'hero_catalogue' (take the hero part(s) of that level from levels.json) or describe a new hero in words.",
  "Rules the game enforces for every level: PASS 85 %, protected <= 5 % damage, unlimited blasts while TNT lasts, TNT only, no placement hints, props not counted (D-blast-THRESH-2, NOHINT, PROPS). Difficulty comes from the surroundings (neighbours, protected buildings, barrels, TNT count, yaw), never from changing the hero (D-blast-HERO-PROC).",
  "Do not invent new mechanics, materials or obstacles (D-blast-NONEW): propose them separately."
 ],
 "fields": {
  "name": "level name shown in game (no real landmark names)",
  "tier": "T | N | R | H | SH",
  "hard": "true on H (purple)",
  "boss": "true on SH (orange)",
  "kind": "always 'scene'",
  "hero": "id of the hero part(s), e.g. 'A' or 'A,B'",
  "heroId": "hero tile id (F01..F35), see hero_catalogue",
  "parts": "buildings. Plain building: {id, kind:'mass', x, z, tiers:[{f storeys, cx bays wide, cz bays deep, ox/oz setback, mat:'wood'|'brick'|'conc'|'steel', skin:'alt'|'full', g:'open'|...}], bay (m, default 3.6), fh storey height (m), colk column factor, st, roof:{cap, tank, ac, sign}}. Optional (editor hook): sc scale 0.5-2.5, mats:{col,floor,deck,wall,glass} member-group materials, rc:{k hp multiplier, keep damage between blasts}",
  "keeps": "protected buildings: [{kind:'keep6', x, z, floors, cx, cz, fixType:'hospital'|'school'}] and keep:{name, sides:[], full:1}",
  "tanks": "explosive barrels: [[x, z], ...]",
  "props": "decoration only, not counted: [{k:'crate'|'tree'|'car', x, z, r}]",
  "charges": "{tnt: n}; T 4-6, otherwise 7-12",
  "target": "0.85 (forced)",
  "yaw": "opening camera angle in rad (0 = from the street side)",
  "fillMax": "share of screen height the hero may fill",
  "lotK": "sand pad scale",
  "mon": "1 = monument camera helpers",
  "base": "{ '<part id>': preset, '*': preset for every other building } presets: weak, weak-tip, stiff, stiff-tip, crush, keep, none",
  "sol": "expert plan: [[charge, 'partId:face', floor, index], ...] face = x- | x+ | z- | z+ ; floor 0 = ground",
  "solW": "same, one list per blast",
  "bot": "{hints:[[kind, 'partId:face', blast#], ...]} what a tip-reading player would try",
  "lesson": "{check:[[...plan without the lesson...]]}",
  "teaches": "one line: the idea of the level (<= 6 words)",
  "tip": "level tip (principle, never a spot)",
  "ftip": "fail tip (<= 9 words, principle)"
 },
